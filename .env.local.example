# Copy to .env.local in the repo root (gitignored). Never commit .env.local.
#   cp .env.local.example .env.local
#   chmod 600 .env.local
# ./scripts/run-local.sh loads this file automatically.
#
# Community multi-LLM BYOK — Gemini is the default. Other providers need the
# local runner proxy (port 8081) because browsers often block direct CORS.
#
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# VERTEX_API_KEY=
# Optional model overrides:
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GROQ_MODEL=llama-3.3-70b-versatile
# VERTEX_MODEL=gemini-2.5-flash
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1
